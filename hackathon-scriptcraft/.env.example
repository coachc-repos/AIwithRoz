# Names only. Copy to .env and fill values on the sandbox machine.
# setup-azure.sh writes .env for you. Never commit .env.

# --- Azure login for the container (service principal or managed identity) ---
AZURE_CLIENT_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_SECRET=
# Managed identity uses IDENTITY_ENDPOINT (set by Azure, not by you).

# --- Foundry project. No default; the package does not call another subscription. ---
FOUNDRY_PROJECT_ENDPOINT=
AZURE_AI_PROJECT_ENDPOINT=
AI_PROJECT_ENDPOINT=

# Deployment names created by setup-azure.sh. The backing model depends on
# regional quota; see infra/models.json.
MAF_CLAUDE_MODEL=
MAF_REVIEWER_MODEL=
MAF_SEARCH_MODEL=
MAF_GROK_MODEL=

# Hosted agents are named "<portal name>-MAF". Optional id only for the
# tournament agent, which is not part of the script pipeline.
TOURNAMENT_AGENT_ID=

# --- Storage the container uses for saved settings and finished videos ---
FINISHED_VIDEOS_BLOB_ACCOUNT=
FINISHED_VIDEOS_BLOB_CONTAINER=
SCRIPTCRAFT_SETTINGS_BLOB_CONTAINER=

# --- Narration. Default provider is Azure AI Speech on the same AI account. ---
TTS_PROVIDER=
TTS_VOICE=
TTS_WPM=
TTS_BASELINE_WPM=
AZURE_SPEECH_REGION=
AZURE_SPEECH_ENDPOINT=
AZURE_SPEECH_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- Optional features. Missing values disable that feature; the app still starts. ---
HEYGEN_API_KEY=
HEYGEN_VOICE_ID=
XAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
AZURE_SEARCH_SERVICE=
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX=
AZURE_AI_SERVICES_ENDPOINT=
AZURE_AI_SERVICES_KEY=
AZURE_OPENAI_ENDPOINT=
APP_AUTH_TOKEN=
SCRIPTCRAFT_DISABLE_LOCAL_FEATURES=
